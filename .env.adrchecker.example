# ============================================================================
# adrchecker — Environment configuration example
# ============================================================================
# Copy this file to `.env` and fill in your values:
#   cp .env.adrchecker.example .env
# ============================================================================

# OpenAI API key (required for OpenAI models)
ADRCHECKER_OPENAI_API_KEY=your-api-key-here

# Model configuration
ADRCHECKER_MODEL=gpt-4o-mini
ADRCHECKER_TEMPERATURE=0.0
# ADRCHECKER_MAX_TOKENS=4096

# Optional: Custom OpenAI-compatible base URL (e.g., for Azure, local LLMs)
# ADRCHECKER_OPENAI_BASE_URL=http://localhost:11434/v1

# Default checking mode: "full", "adherence", or "sections"
ADRCHECKER_DEFAULT_MODE=full

# Enable parallel processing by default
ADRCHECKER_PARALLEL=true