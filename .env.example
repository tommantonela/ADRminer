# ADRminer Environment Variables
# Copy this file to .env and configure your API keys
# Only LLM inference and embeddings variables go here
# All other configuration options should be in ~/.adrminer.yaml

# LLM Provider API Keys
# OpenAI (for gpt-4.1-mini, gpt-4o, etc.)
# OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic (for claude-3-sonnet, claude-3-haiku, etc.)
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Azure OpenAI
# AZURE_OPENAI_API_KEY=your-azure-api-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Google Vertex AI
# GOOGLE_API_KEY=your-google-api-key
# GOOGLE_PROJECT=your-project-id

# Ollama (for local models)
# OLLAMA_BASE_URL=http://localhost:11434